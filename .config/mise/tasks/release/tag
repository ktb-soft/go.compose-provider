#!/usr/bin/env bash
#MISE description="Tag a release and push it to origin"
set -euo pipefail

readonly remote="origin"
readonly module="github.com/ktb-soft/go.compose-provider"
readonly version="${1:-}"

if [[ -z ${version} ]]; then
  echo "usage: mise run release:tag <version>, for example v0.1.0" >&2
  exit 1
fi

if [[ ! ${version} =~ ^v[0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z.-]+)?$ ]]; then
  echo "error: ${version} is not a semver tag, expected the vMAJOR.MINOR.PATCH form" >&2
  exit 1
fi

if [[ -n $(git status --porcelain) ]]; then
  echo "error: the working tree is dirty, commit or stash before tagging" >&2
  exit 1
fi

git fetch --quiet --tags "${remote}"

if git rev-parse --verify --quiet "refs/tags/${version}" >/dev/null; then
  echo "error: tag ${version} already exists locally" >&2
  exit 1
fi

if [[ -n $(git ls-remote --tags "${remote}" "refs/tags/${version}") ]]; then
  echo "error: tag ${version} already exists on ${remote}" >&2
  exit 1
fi

branch="$(git rev-parse --abbrev-ref HEAD)"
readonly branch
if ! git rev-parse --verify --quiet "refs/remotes/${remote}/${branch}" >/dev/null; then
  echo "error: ${branch} has no counterpart on ${remote}, push it before tagging" >&2
  exit 1
fi
if [[ -n $(git rev-list "${remote}/${branch}..HEAD") ]]; then
  echo "error: ${branch} is ahead of ${remote}/${branch}, push the commits before tagging" >&2
  exit 1
fi

mise run check

git tag --annotate "${version}" --message "Release ${version}"
git push "${remote}" "refs/tags/${version}"

echo
echo "published ${version} from ${branch}"
echo "the proxy picks it up on the first fetch:"
echo "  go list -m ${module}@${version}"
